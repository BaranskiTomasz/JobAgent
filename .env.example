ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...
# Optional catalog-only override. The default is claude-haiku-5-5.
# CLAUDE_CATALOG_EXTRACT_MODEL=claude-haiku-5-5

# Optional — auto-fills the LinkedIn login form on first run. Leave unset to
# log in manually in the browser window instead (also handles 2FA/CAPTCHA).
LINKEDIN_EMAIL=your@email.com
LINKEDIN_PASSWORD=yourpassword

# Where JobAgentWeb (see ../JobAgentWeb) is reachable from this machine.
# Defaults to the WireGuard-tunneled VPS address if unset — only set this if
# you're pointing at a different JobAgentWeb instance (e.g. running it locally).
# JOBAGENTWEB_BASE_URL=http://10.66.0.1:8000

# Optional — authenticates every request with a static key instead of a
# browser session cookie, so this installation never needs an interactive
# `scripts/login.py` re-run. Must match JOBAGENT_API_KEY in JobAgentWeb's own
# .env on the server (see deploy/env.example in this repo for how that side
# is generated/configured). Leave unset to keep using session-cookie login.
# JOBAGENT_API_KEY=
